# Variables del frontend (copiar a frontend/.env)
# cp .env.example .env

# El navegador llama a la API con rutas RELATIVAS (`/api/...`) en el mismo
# origen que sirve Vite; el proxy de `vite.config.js` reenvía la petición al
# backend. Por eso NO hace falta CORS ni configuración adicional en el backend.

# Destino del proxy en desarrollo (por defecto: http://localhost:8000).
# En Docker, docker-compose define VITE_API_PROXY_TARGET=http://backend:8000.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Opcional: sólo si el frontend debe hablar DIRECTAMENTE contra otro origen
# (deja de usar el proxy). Vacío = mismo origen (recomendado).
# VITE_API_URL=
