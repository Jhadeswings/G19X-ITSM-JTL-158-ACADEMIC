# Variables del backend (copiar a backend/.env)
# cp .env.example .env

# Conexión a PostgreSQL.
# - Fuera de Docker: host localhost, puerto expuesto en el host (5433 por defecto).
# - Dentro de docker compose esta variable la sobreescribe el propio compose (host "db", puerto 5432).
DATABASE_URL=postgresql+psycopg2://talento:talento_local@localhost:5433/talento_alto_potencial

# Zona horaria de negocio (Especificación Técnica §1)
TZ=America/Mexico_City

# --- Autenticación (Fase 3) ---
# Clave para firmar JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# OBLIGATORIA: sin ella la aplicación no arranca. NUNCA commitear el .env.
SECRET_KEY=cambiar-por-una-clave-generada

# Vida útil (minutos) del JWT de acceso y del token de recuperación
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# Credenciales del seed de RH inicial (Especificación Técnica §35).
# Solo para el seed inicial; deben cumplir la política del PRD §3.5
# (mínimo 8 caracteres y al menos un número).
SEED_RH_EMAIL=rh@empresa.dev
SEED_RH_PASSWORD=Cambia4Me

# SOLO DESARROLLO: escribir el token de recuperación en el log del backend
# (no existe proveedor de correo definido). NO usar como mecanismo de
# envío en producción.
RECOVERY_TOKEN_DEV_LOG=true

# --- IA (Fase 8): interpretación de búsqueda (Especificación §27) ---
# Opcionales. Groq es el proveedor primario y Gemini el fallback. Sin
# claves, POST /api/v1/rh/talent-search/interpret responde 502 controlado
# y el resto del sistema funciona con normalidad. NUNCA commitear claves.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
