# Variables para Docker Compose (copiar a .env en la raíz del proyecto)
# cp .env.example .env

POSTGRES_USER=talento
POSTGRES_PASSWORD=talento_local
POSTGRES_DB=talento_alto_potencial
# Puerto de PostgreSQL expuesto en el HOST (evita chocar con un PostgreSQL local en 5432)
POSTGRES_PORT=5433

# --- Autenticación (Fase 3) ---
# Clave para firmar JWT del backend. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-generada

# Credenciales del seed de RH inicial (Especificación Técnica §35).
# Nunca commitear secretos reales: copia este archivo a .env y ajusta.
SEED_RH_EMAIL=rh@empresa.dev
SEED_RH_PASSWORD=Cambia4Me
